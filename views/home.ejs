<% layout("/layouts/boilerplate") %>

<div class="page-shell home-page">
  <section class="discovery-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="hero-eyebrow">Curated stays, closer than you think</p>
      <h1 id="hero-title">Stay somewhere worth remembering.</h1>
      <p class="hero-summary">Find character-rich homes chosen for comfort, calm, and a strong sense of place.</p>
      <div class="hero-actions">
        <a class="btn btn-light" href="/listings">Explore stays</a>
        <a class="hero-text-link" href="/listings/new">List your place <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
    <div class="hero-media">
      <img
        src="/images/wanderstay-hero-v2.jpg"
        alt="A secluded timber retreat overlooking a calm mountain lake"
        width="1672"
        height="941"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="home-intro" aria-labelledby="home-intro-title">
    <div>
      <h2 id="home-intro-title">Travel with a little more character.</h2>
    </div>
    <div class="home-principles">
      <article>
        <i class="ph ph-diamond" aria-hidden="true"></i>
        <div>
          <h3>Distinctive by design</h3>
          <p>Browse homes chosen for atmosphere, setting, and the details that make a trip memorable.</p>
        </div>
      </article>
      <article>
        <i class="ph ph-chat-circle-text" aria-hidden="true"></i>
        <div>
          <h3>Shared by real guests</h3>
          <p>Read honest notes from travellers and add your own after every stay.</p>
        </div>
      </article>
      <article>
        <i class="ph ph-compass" aria-hidden="true"></i>
        <div>
          <h3>Made for thoughtful hosts</h3>
          <p>Present your place clearly, manage the details, and welcome people who value it.</p>
        </div>
      </article>
    </div>
  </section>
</div>
