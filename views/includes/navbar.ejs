          <a class="nav-link" data-nav-path="/login" href="/login">Log in</a>
          <a class="btn btn-primary nav-signup" data-nav-path="/signup" href="/signup">Sign up</a>
          <% } else { %>
            <span class="nav-user" aria-label="Signed in user">
              <i class="fa-regular fa-circle-user" aria-hidden="true"></i>
              <%= currUser.username %>
            </span>
            <a class="nav-link" href="/logout">Log out</a>
