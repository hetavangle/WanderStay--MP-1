<nav class="navbar navbar-expand-lg sticky-top site-navbar" aria-label="Primary navigation">
  <div class="page-shell navbar-shell">
    <a class="navbar-brand brand-lockup" href="/" aria-label="WanderStay home">
      <span class="brand-mark" aria-hidden="true">
        <i class="fa-regular fa-compass"></i>
      </span>
      <span>WanderStay</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNavigation"
      aria-controls="primaryNavigation" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="primaryNavigation">
      <div class="navbar-nav nav-primary">
