        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <label class="visually-hidden" for="site-search">Search stays</label>
        <input id="site-search" class="form-control search-inp" type="search" name="q"
          value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" placeholder="Search destinations" />
        <button class="search-btn" type="submit">Search</button>
      </form>
      <div class="navbar-nav nav-actions">
        <a class="nav-link" href="/listings/new">Become a host</a>
