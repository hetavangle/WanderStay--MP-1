<% layout("/layouts/boilerplate") %>

<div class="page-shell form-page">
  <a class="back-link" href="/listings/<%= listing._id %>"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to listing</a>
  <div class="editor-layout">
    <section class="editor-panel" aria-labelledby="edit-listing-title">
      <div class="form-header">
        <p class="section-kicker">Manage your place</p>
        <h1 id="edit-listing-title">Edit <%= listing.title %></h1>
        <p>Keep the details accurate so guests know exactly what to expect.</p>
      </div>
      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="form-field">
          <label for="title" class="form-label">Listing title</label>
          <input id="title" name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required />
          <div class="invalid-feedback">Please enter a title.</div>
        </div>

        <div class="form-field">
          <label for="description" class="form-label">Description</label>
          <textarea id="description" name="listing[description]" class="form-control" rows="5" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please provide a description.</div>
        </div>

        <div class="current-image-block">
          <span class="form-label">Current image</span>
          <img src="<%= originalImgUrl %>" alt="Current image for <%= listing.title %>" class="image-preview" />
        </div>

        <div class="form-field">
          <label for="image" class="form-label">Replace image</label>
          <input id="image" name="listing[image]" type="file" class="form-control" accept="image/*" />
          <p class="form-help">Leave this empty to keep the current image.</p>
        </div>

        <div class="form-grid">
          <div class="form-field">
            <label for="price" class="form-label">Nightly price</label>
            <div class="input-prefix">
              <span aria-hidden="true">&#8377;</span>
              <input id="price" name="listing[price]" value="<%= listing.price %>" type="number" min="1" class="form-control" required />
            </div>
            <div class="invalid-feedback">Please enter a price greater than 0.</div>
          </div>
          <div class="form-field">
            <label for="category" class="form-label">Category</label>
            <select id="category" name="listing[category]" class="form-select" required>
              <% for (const category of listingCategories) { %>
                <option value="<%= category.value %>" <%= (listing.category || "Trending") === category.value ? "selected" : "" %>><%= category.value %></option>
              <% } %>
            </select>
            <div class="invalid-feedback">Please select a category.</div>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-field">
            <label for="location" class="form-label">Location</label>
            <input id="location" name="listing[location]" value="<%= listing.location %>" type="text" class="form-control" required />
            <div class="invalid-feedback">Please enter a location.</div>
          </div>
          <div class="form-field">
            <label for="country" class="form-label">Country</label>
            <input id="country" name="listing[country]" value="<%= listing.country %>" type="text" class="form-control" required />
            <div class="invalid-feedback">Please enter a country.</div>
          </div>
        </div>

        <div class="form-actions">
          <button class="btn btn-primary" type="submit">Save changes</button>
          <a class="btn btn-secondary" href="/listings/<%= listing._id %>">Cancel</a>
        </div>
      </form>
    </section>

    <aside class="editor-aside">
      <div class="editor-aside-icon" aria-hidden="true"><i class="fa-regular fa-pen-to-square"></i></div>
      <h2>Keep the listing current</h2>
      <ul>
        <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Reflect seasonal changes in the description</span></li>
        <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Use a recent image that matches the stay</span></li>
        <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Review the price before saving</span></li>
      </ul>
      <p>Accurate details help guests book with confidence.</p>
    </aside>
  </div>
</div>
